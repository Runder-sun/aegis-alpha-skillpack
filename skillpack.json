{
  "name": "aegis-alpha",
  "display_name": "Aegis Alpha",
  "version": "0.1.0",
  "private": false,
  "description": "Research-only multi-agent investment skillpack with fail-closed data, provenance, screening, research, paper planning, portfolio review, advice lifecycle, and report evolution workflows.",
  "canonical_source": "skills/aegis-alpha",
  "public_skill_limit": 15,
  "public_skills": [
    "information-retrieval",
    "market-data",
    "market-intel",
    "macro-regime",
    "theme-cycle",
    "equity-screening",
    "equity-research",
    "trade-planning",
    "portfolio-ops",
    "advice-lifecycle",
    "pipeline",
    "quality-gate",
    "quant-validation",
    "report-evolution",
    "execution-automation"
  ],
  "supported_agents": {
    "codex": {
      "adapter": "adapters/codex",
      "layout": "native-public-skillset",
      "default_target": "$CODEX_HOME/skills or ~/.codex/skills",
      "installs": [".aegis-alpha-core", "aegis-alpha", "aegis-alpha-<public-skill>"],
      "resource_mode": "symlink by default, copy fallback"
    },
    "hermes": {
      "adapter": "adapters/hermes",
      "layout": "package",
      "default_target": "$HERMES_HOME/skills/aegis-alpha or ~/.hermes/skills/aegis-alpha"
    },
    "openclaw": {
      "adapter": "adapters/openclaw",
      "layout": "package",
      "default_target": "$OPENCLAW_HOME/skills/aegis-alpha or ~/.openclaw/skills/aegis-alpha"
    },
    "claude-code": {
      "adapter": "adapters/claude-code",
      "layout": "native-public-skillset",
      "default_target": "$CLAUDE_CODE_SKILLS_HOME or ./.claude/skills",
      "installs": [".aegis-alpha-core", "aegis-alpha", "aegis-alpha-<public-skill>"],
      "resource_mode": "symlink by default, copy fallback"
    }
  },
  "environment": {
    "workspace": "AEGIS_ALPHA_WORKSPACE",
    "default_workspace": "~/.aegis-alpha/workspace",
    "repo": "AEGIS_ALPHA_REPO",
    "runtime_profile": "~/.aegis-alpha/workspace/config/runtime-profile.json"
  },
  "runtime_configuration": {
    "presets": ["quick-research", "daily-desk", "portfolio-desk", "report-review", "full-institutional"],
    "workflow_scopes": ["core-research", "market-desk", "portfolio-review", "report-review", "full-institutional"],
    "data_providers": ["agent_native", "skill_api"],
    "cache_policies": ["none", "read-if-fresh", "cache-first", "refresh-if-stale", "prewarm-required"],
    "manual_input_policies": ["ask-when-missing", "disabled"],
    "portfolio_sources": ["none", "manual-ledger", "imported-file", "read-only-api"],
    "portfolio_modes": ["none", "manual-ledger", "imported-file", "read-only-api"],
    "heartbeat_modes": ["none", "manual", "daily-prewarm", "market-heartbeat", "full"],
    "provider_policy": "Data providers are composable acquisition channels ordered by runtime profile priority. Agent-native and skill APIs are compatible and not mutually exclusive. Workspace cache/prewarm and manual user input are separate policies, not providers.",
    "preset_policy": "Presets are default operating profiles, not feature gates; all public skills remain available after any preset."
  },
  "conductor": {
    "bootstrap": "skills/aegis-alpha/scripts/bootstrap_runtime.py",
    "provider_resolver": "skills/aegis-alpha/scripts/provider_resolver.py",
    "capability_guide": "skills/aegis-alpha/data/capability-guide.json",
    "automation_playbook": "skills/aegis-alpha/references/automation-playbook.md",
    "automation_jobs": "skills/aegis-alpha/data/automation-jobs.json",
    "provider_capabilities": "skills/aegis-alpha/data/provider-capabilities.json"
  },
  "safety_policy": {
    "decision_allowed": false,
    "requires_human_confirmation": true,
    "fail_closed": true,
    "no_silent_fallback": true,
    "no_empty_success_for_missing_evidence": true,
    "max_action_levels": [
      "data_only",
      "research_only",
      "paper_plan_only",
      "analysis_only",
      "quality_validation_only",
      "report_review_only",
      "automation_only"
    ]
  },
  "validation": {
    "final_acceptance": "tools/check_final_acceptance.py",
    "public_contracts": "tools/check_public_contracts.py",
    "pipeline_integrity": "tools/check_pipeline_integrity.py",
    "critical_smoke": "tools/smoke_portfolio_position_research.py",
    "closed_loop_smoke": "tools/smoke_investment_closed_loop.py"
  }
}
