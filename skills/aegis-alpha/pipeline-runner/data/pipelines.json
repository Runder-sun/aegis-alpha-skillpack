    {
      "id": "theme-discovery-daily",
      "label": "每日动态主题发现",
      "description": "每日动态主题闭环 (信号记录 → 主题注册 → 覆盖规划 → 候选记录 → 股池刷新 → 审计 → 深挖队列)",
      "steps": [
        {
          "package": "execution-automation",
          "command": "nightly-prewarm",
          "optional": true,
          "note": "可选数据预热，自动任务中建议先运行"
        },
        {
          "package": "market-intel",
          "command": "daily-news-scan",
          "optional": true,
          "note": "新闻/政策/事件信号输入"
        },
        {
          "package": "theme-cycle",
          "command": "record-theme-signals",
          "optional": false,
          "note": "记录结构化主题信号到证据账本"
        },
        {
          "package": "theme-cycle",
          "command": "write-theme-registry",
          "optional": false,
          "note": "更新动态主题注册表和主题链图"
        },
        {
          "package": "equity-screening",
          "command": "plan-theme-coverage",
          "optional": false,
          "note": "规划主题节点和市场覆盖，暴露缺口"
        },
        {
          "package": "equity-screening",
          "command": "record-theme-candidates",
          "optional": false,
          "note": "记录 agent 发现或用户提供的候选；无候选时 fail-closed"
        },
        {
          "package": "equity-screening",
          "command": "refresh-theme-stock-pool",
          "optional": false,
          "note": "刷新主题候选股池"
        },
        {
          "package": "equity-screening",
          "command": "theme-stock-pool-audit",
          "optional": false,
          "note": "审计证据覆盖、陈旧度和可用性"
        },
        {
          "package": "equity-screening",
          "command": "batch-theme-research",
          "optional": true,
          "note": "生成 equity-research 深挖队列"
        }
      ]
    },
