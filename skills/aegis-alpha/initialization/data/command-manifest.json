{
  "package": "initialization",
  "description": "First-run and reconfiguration workflow for Aegis Alpha runtime profiles.",
  "safety_policy": {
    "decision_allowed": false,
    "requires_human_confirmation": true,
    "max_action_level": "configuration_only",
    "fail_closed": true
  },
  "commands": [
    {
      "name": "init-status",
      "description": "Inspect whether a runtime profile exists and summarize current initialization state.",
      "status": "implemented",
      "payload_schema": {
        "type": "object",
        "properties": {
          "workspace": {"type": "string"}
        }
      },
      "result_schema": {"$ref": "#/$defs/initialization_result"},
      "example": {},
      "upstream_dependencies": [
        "AEGIS_ALPHA_WORKSPACE or default ~/.aegis-alpha/workspace"
      ],
      "freshness_policy": "Status is read directly from the current runtime profile path at command runtime.",
      "error_behavior": [
        "profile_missing",
        "profile_unreadable",
        "invalid_payload"
      ]
    },
    {
      "name": "init-plan",
      "description": "Build a user-facing initialization plan for a preset without writing runtime state.",
      "status": "implemented",
      "payload_schema": {
        "type": "object",
        "properties": {
          "preset": {
            "type": "string",
            "enum": ["auto", "quick-research", "daily-desk", "portfolio-desk", "report-review", "full-institutional"]
          }
        }
      },
      "result_schema": {"$ref": "#/$defs/initialization_result"},
      "example": {"preset": "full-institutional"},
      "upstream_dependencies": [
        "capability-guide.json",
        "skillpack.json"
      ],
      "freshness_policy": "Plan is derived from bundled configuration files at command runtime.",
      "error_behavior": [
        "capability_guide_missing",
        "invalid_preset",
        "invalid_payload"
      ]
    },
    {
      "name": "bootstrap-profile",
      "description": "Write a confirmed Aegis Alpha runtime profile after the user chooses preset and required axes.",
      "status": "implemented",
      "payload_schema": {
        "type": "object",
        "required": ["user_confirmed", "preset"],
        "properties": {
          "user_confirmed": {"type": "boolean", "const": true},
          "agent": {"type": "string"},
          "preset": {"type": "string"},
          "data_providers": {"type": "string"},
          "cache_policy": {"type": "string"},
          "manual_input": {"type": "string"},
          "portfolio_source": {"type": "string"},
          "heartbeat": {"type": "string"},
          "external_push": {"type": "string"},
          "workspace": {"type": "string"}
        }
      },
      "result_schema": {"$ref": "#/$defs/initialization_result"},
      "example": {
        "user_confirmed": true,
        "agent": "codex",
        "preset": "quick-research",
        "data_providers": "agent_native,skill_api",
        "cache_policy": "read-if-fresh",
        "manual_input": "ask-when-missing",
        "portfolio_source": "none",
        "heartbeat": "none"
      },
      "upstream_dependencies": [
        "scripts/bootstrap_runtime.py",
        "confirmed user choices"
      ],
      "freshness_policy": "Runtime profile timestamps are generated by bootstrap_runtime.py at write time.",
      "error_behavior": [
        "user_confirmation_missing",
        "missing_required_axis",
        "bootstrap_failed",
        "invalid_payload"
      ]
    }
  ],
  "$defs": {
    "initialization_result": {
      "type": "object",
      "required": [
        "command",
        "decision_allowed",
        "errors",
        "ok",
        "package",
        "payload",
        "result",
        "warnings"
      ],
      "properties": {
        "package": {"type": "string", "const": "initialization"},
        "command": {"type": "string"},
        "payload": {"type": "object"},
        "result": {"type": "object"},
        "ok": {"type": "boolean"},
        "decision_allowed": {"type": "boolean", "const": false},
        "requires_human_confirmation": {"type": "boolean", "const": true},
        "as_of": {"type": "string"},
        "freshness": {"type": "object"},
        "source": {"type": ["array", "string"], "items": {"type": "string"}},
        "sources": {"type": "array", "items": {"type": "string"}},
        "artifacts": {"type": "array", "items": {"type": "string"}},
        "warnings": {"type": "array", "items": {"type": "string"}},
        "errors": {"type": "array", "items": {"type": "string"}},
        "missing_critical_inputs": {"type": "array"},
        "max_action_level": {"type": "string", "const": "configuration_only"}
      }
    }
  }
}
