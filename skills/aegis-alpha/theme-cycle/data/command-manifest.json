      },
      "result_schema": {
        "$ref": "#/$defs/theme_result"
      },
      "upstream_dependencies": [
        "memory/prewarm/nightly-prewarm-*.json",
        "memory/themes.json",
        "macro-regime public outputs"
      ],
      "freshness_policy": "Theme freshness is inherited from theme store updated_at, latest prewarm artifact, and macro-regime outputs.",
      "error_behavior": [
        "theme_store_missing",
        "market_risk_inputs_missing",
        "event_inputs_missing",
        "theme_inputs_missing"
      ],
      "example": {}
    },
