      },
      "example": {
        "dry_run": true
      },
      "upstream_dependencies": [
        "pipeline-runner facade route",
        "pipeline-orchestrator facade route",
        "workspace skills"
      ],
      "freshness_policy": "Pipeline freshness is delegated to the routed pipeline artifact and step outputs.",
      "error_behavior": [
        "pipeline_not_found",
        "delegate_failed",
        "dispatch_not_found",
        "pipeline_step_failed"
      ]
    },
    {
      "name": "pipeline-run-weekly",
      "description": "Run or dry-run the weekly workflow.",
      "status": "implemented",
      "routes_to": "pipeline-orchestrator::pipeline-run",
