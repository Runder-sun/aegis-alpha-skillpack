    }
  ],
  "$defs": {
    "pipeline_payload": {
      "type": "object",
      "properties": {
        "pipeline_id": {
          "type": "string",
          "enum": [
            "nightly",
            "morning",
            "market-review",
            "weekly",
            "theme-discovery-daily",
            "theme-discovery-weekly"
          ]
        },
        "dry_run": {
          "type": "boolean",
          "default": false
        },
        "allow_push": {
          "type": "boolean",
          "default": false
        },
        "max_fail": {
          "type": "integer",
          "minimum": 0
        },
        "skip_packages": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "skip_commands": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "facade_result": {
      "type": "object",
      "required": [
        "as_of",
        "decision_allowed",
        "errors",
        "max_action_level",
        "missing_critical_inputs",
        "ok",
        "requires_human_confirmation",
        "result",
        "sources",
        "warnings"
      ],
      "properties": {
        "ok": {
          "type": "boolean"
        },
        "decision_allowed": {
          "type": "boolean",
          "const": false
        },
        "requires_human_confirmation": {
          "type": "boolean",
          "const": true
        },
        "max_action_level": {
          "type": "string",
          "const": "workflow_orchestration_only"
        },
        "as_of": {
          "type": "string"
        },
        "freshness": {
          "type": "object"
        },
        "source": {
          "type": "string"
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "artifacts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "missing_critical_inputs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "result": {
          "type": "object"
        }
      }
    }
  }
}
