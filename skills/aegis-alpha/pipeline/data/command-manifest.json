{
  "package": "pipeline",
  "description": "Public investment workflow pipeline facade for listing templates, dry-runs, and auditable execution.",
  "safety_policy": {
    "decision_allowed": false,
    "requires_human_confirmation": true,
    "max_action_level": "workflow_orchestration_only",
    "fail_closed": true,
    "push_disabled_by_default": true
  },
  "commands": [
    {
      "name": "pipeline-list",
      "description": "List available investment workflow templates.",
      "status": "implemented",
      "routes_to": "pipeline-runner::pipeline-list",
      "payload_schema": {
        "type": "object"
      },
      "result_schema": {
        "$ref": "#/$defs/facade_result"
      },
      "example": {},
      "upstream_dependencies": [
        "pipeline-runner facade route",
        "pipeline-orchestrator facade route",
        "workspace skills"
      ],
      "freshness_policy": "Pipeline freshness is delegated to the routed pipeline artifact and step outputs.",
      "error_behavior": [
        "pipeline_not_found",
        "delegate_failed",
        "dispatch_not_found",
        "pipeline_step_failed"
      ]
    },
    {
      "name": "pipeline-dry-run",
      "description": "Validate a pipeline path without running steps.",
      "status": "implemented",
      "routes_to": "pipeline-orchestrator::pipeline-dry-run",
      "payload_schema": {
        "$ref": "#/$defs/pipeline_payload"
      },
      "result_schema": {
        "$ref": "#/$defs/facade_result"
      },
      "example": {
        "pipeline_id": "nightly",
        "dry_run": true
      },
      "upstream_dependencies": [
        "pipeline-runner facade route",
        "pipeline-orchestrator facade route",
        "workspace skills"
      ],
      "freshness_policy": "Pipeline freshness is delegated to the routed pipeline artifact and step outputs.",
      "error_behavior": [
        "pipeline_not_found",
        "delegate_failed",
        "dispatch_not_found",
        "pipeline_step_failed"
      ]
    },
    {
      "name": "pipeline-run",
      "description": "Run a named pipeline and persist an auditable result artifact.",
      "status": "implemented",
      "routes_to": "pipeline-orchestrator::pipeline-run",
      "payload_schema": {
        "$ref": "#/$defs/pipeline_payload"
      },
      "result_schema": {
        "$ref": "#/$defs/facade_result"
      },
      "example": {
        "pipeline_id": "weekly",
        "allow_push": false
      },
      "upstream_dependencies": [
        "pipeline-runner facade route",
        "pipeline-orchestrator facade route",
        "workspace skills"
      ],
      "freshness_policy": "Pipeline freshness is delegated to the routed pipeline artifact and step outputs.",
      "error_behavior": [
        "pipeline_not_found",
        "delegate_failed",
        "dispatch_not_found",
        "pipeline_step_failed"
      ]
    },
    {
      "name": "pipeline-run-nightly",
      "description": "Run or dry-run the nightly workflow.",
      "status": "implemented",
      "routes_to": "pipeline-orchestrator::pipeline-run",
      "payload_schema": {
        "$ref": "#/$defs/pipeline_payload"
      },
      "result_schema": {
        "$ref": "#/$defs/facade_result"
      },
      "example": {
        "dry_run": true
      },
      "upstream_dependencies": [
        "pipeline-runner facade route",
        "pipeline-orchestrator facade route",
        "workspace skills"
      ],
      "freshness_policy": "Pipeline freshness is delegated to the routed pipeline artifact and step outputs.",
      "error_behavior": [
        "pipeline_not_found",
