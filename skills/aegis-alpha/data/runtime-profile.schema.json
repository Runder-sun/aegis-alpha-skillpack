{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Aegis Alpha Runtime Profile",
  "type": "object",
  "required": ["schema_version", "package", "agent", "preset", "workflow_scope", "portfolio_source", "workspace", "data_source_mode", "data_provider_priority", "automation", "providers", "safety"],
  "properties": {
    "schema_version": {"type": "integer"},
    "package": {"const": "aegis-alpha"},
    "agent": {"type": "string"},
    "preset": {
      "enum": ["quick-research", "daily-desk", "portfolio-desk", "report-review", "full-institutional"]
    },
    "mode": {
      "description": "Compatibility alias for preset. Legacy mode values may appear in older profiles.",
      "enum": ["quick-research", "daily-desk", "portfolio-desk", "report-review", "full-institutional", "offline-research", "agent-native", "api-assisted", "manual-portfolio"]
    },
    "legacy_mode": {
      "enum": ["offline-research", "agent-native", "api-assisted", "manual-portfolio", "report-review", "full-institutional", null]
    },
    "preset_policy": {
      "type": "object",
      "properties": {
        "type": {"const": "default_orchestration"},
        "feature_gate": {"const": false},
        "all_public_skills_available": {"const": true},
        "out_of_preset_requests": {"type": "string"}
      }
    },
    "workflow_scope": {
      "enum": ["core-research", "market-desk", "portfolio-review", "report-review", "full-institutional"]
    },
    "portfolio_source": {
      "enum": ["none", "manual-ledger", "imported-file", "read-only-api"]
    },
    "portfolio_mode": {
      "description": "Compatibility alias for portfolio_source.",
      "enum": ["none", "manual-ledger", "imported-file", "read-only-api"]
    },
    "capability_level": {"type": "string"},
    "workspace": {"type": "string"},
    "data_source_mode": {
      "enum": ["manual_payload", "agent_native", "skill_api", "cache_or_prewarm"]
    },
    "data_source_modes": {
      "type": "array",
      "items": {"enum": ["manual_payload", "agent_native", "skill_api", "cache_or_prewarm"]},
      "minItems": 1
    },
    "data_provider_priority": {
      "type": "array",
      "items": {"enum": ["manual_payload", "agent_native", "skill_api", "cache_or_prewarm"]},
      "minItems": 1
    },
    "automation": {"type": "object"},
    "providers": {"type": "object"},
    "safety": {
      "type": "object",
      "required": ["decision_allowed", "requires_human_confirmation", "live_trading_allowed"],
      "properties": {
        "decision_allowed": {"const": false},
        "requires_human_confirmation": {"const": true},
        "external_push_requires_confirmation": {"type": "boolean"},
        "live_trading_allowed": {"const": false}
      }
    },
    "next_actions": {"type": "array", "items": {"type": "string"}}
  }
}
