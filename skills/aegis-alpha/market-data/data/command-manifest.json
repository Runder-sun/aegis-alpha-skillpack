{
  "package": "market-data",
  "description": "Consolidated structured market data from nightly prewarm.",
  "safety_policy": {
    "decision_allowed": false,
    "requires_human_confirmation": true,
    "max_action_level": "data_only",
    "fail_closed": true,
    "requires_prewarm_artifact": true
  },
  "commands": [
    {
      "name": "snapshot-full",
      "description": "Return the full HHXG market snapshot from the latest prewarm artifact.",
      "status": "implemented",
      "payload_schema": {
        "type": "object"
      },
      "result_schema": {
        "$ref": "#/$defs/market_data_result"
      },
      "example": {},
      "upstream_dependencies": [
        "memory/prewarm/nightly-prewarm-*.json"
      ],
      "freshness_policy": "Data is read only from the latest prewarm artifact; missing artifact or missing command field fails closed.",
      "error_behavior": [
        "prewarm_directory_missing",
        "prewarm_artifact_missing",
        "prewarm_artifact_invalid_json",
        "required_market_data_missing"
      ]
    },
    {
      "name": "margin-full",
      "description": "Return HHXG margin data from the latest prewarm artifact.",
