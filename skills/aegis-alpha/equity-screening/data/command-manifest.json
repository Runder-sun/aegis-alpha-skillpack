  "$defs": {
    "candidate": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "theme": {
          "type": "string"
        },
        "net_yi": {
          "type": "number"
        },
        "limitup": {
          "type": "number"
        },
        "news_hits": {
          "type": "number"
        },
        "research_hits": {
          "type": "number"
        },
        "reason": {
          "type": "string"
        },
        "source": {
          "type": "string"
        }
      }
    },
    "candidate_screen_payload": {
      "type": "object",
      "properties": {
        "candidates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/candidate"
          }
        },
        "min_score": {
          "type": "number",
          "default": 0
        }
      }
    },
    "candidate_rating_payload": {
      "type": "object",
      "properties": {
        "candidate": {
          "$ref": "#/$defs/candidate"
        },
        "code": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "theme": {
          "type": "string"
        },
        "net_yi": {
          "type": "number"
        },
        "news_hits": {
          "type": "number"
        },
        "research_hits": {
          "type": "number"
        }
      }
    },
    "board_sync_payload": {
      "type": "object",
      "properties": {
        "boards": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "evidence_payload": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "query": {
          "type": "string"
        },
        "reports": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "news": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "screening_result": {
      "type": "object",
      "required": [
        "decision_allowed",
        "errors",
        "ok",
        "result",
        "warnings"
      ],
      "properties": {
        "ok": {
          "type": "boolean"
        },
        "decision_allowed": {
          "type": "boolean",
          "const": false
        },
        "max_action_level": {
          "type": "string",
          "const": "research_only"
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "artifacts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "result": {
          "type": "object"
        },
        "requires_human_confirmation": {
          "type": "boolean",
          "const": true
        },
        "as_of": {
          "type": "string"
        },
        "freshness": {
          "type": "object"
        },
        "source": {
          "type": [
            "array",
            "string"
          ],
          "items": {
            "type": "string"
          }
        },
        "missing_critical_inputs": {
          "type": "array"
        }
      }
    },
    "theme_chain_screen_payload": {
      "type": "object",
      "properties": {
        "theme_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "node_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "regions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "max_forward_pe": {
          "type": "number"
        },
        "min_score": {
          "type": "number",
          "default": 0
        },
        "theme_map": {
          "type": "object"
        }
      }
    }
  }
}
