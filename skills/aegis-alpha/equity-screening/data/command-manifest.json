    {
      "name": "theme-chain-screening",
      "description": "Use the bundled AI infrastructure chain template/fixture to score example candidates; not a full market scan.",
      "status": "implemented",
      "legacy_functions": [
        "theme_chain_screening"
      ],
      "payload_schema": {
        "$ref": "#/$defs/theme_chain_screen_payload"
      },
      "result_schema": {
        "$ref": "#/$defs/screening_result"
      },
      "upstream_dependencies": [
        "data/theme-chain-template.ai-infrastructure.json or payload.theme_map"
      ],
      "freshness_policy": "Template freshness is static and for schema/ontology/testing; real stock pools require recorded candidates.",
      "error_behavior": [
        "theme_chain_map_missing",
        "theme_chain_map_invalid_json",
        "theme_chain_candidates_missing",
        "prewarm_snapshot_missing"
      ],
      "example": {
        "max_forward_pe": 20,
        "theme_ids": [
          "ai-infrastructure"
        ]
      }
    },
    {
      "status": "implemented",
      "payload_schema": {
        "$ref": "#/$defs/theme_chain_screen_payload"
      },
      "result_schema": {
        "$ref": "#/$defs/screening_result"
      },
      "upstream_dependencies": [
        "memory/dynamic_themes/theme-chain-map.json",
        "memory/dynamic_themes/theme-candidates.jsonl when present"
      ],
      "freshness_policy": "Coverage freshness is inherited from the current theme-chain map and recorded candidate ledger.",
      "error_behavior": [
        "theme_chain_map_missing",
        "theme_nodes_missing",
        "theme_candidates_missing"
      ],
      "example": {
        "theme_ids": [
          "ai-infrastructure"
        ],
        "required_markets": [
          "CN",
          "HK",
          "US",
          "JP",
          "KR",
          "TW"
        ]
      },
