      "upstream_dependencies": [
        "explicit candidates",
        "explicit themes",
        "explicit technical levels",
        "latest prewarm market gate when used"
      ],
      "freshness_policy": "Plan freshness is inherited from supplied market gate, candidates, themes, and technical levels.",
      "error_behavior": [
        "candidates_missing",
        "themes_missing",
        "technical_inputs_missing",
        "market_filter_missing"
      ],
      "example": {
        "themesurfer_status": "FULL",
        "risk_level": "green",
        "candidates": [
          {
            "name": "示例公司"
          }
        ],
        "technical": {
          "price": 10,
          "ma20": 9
        }
      }
    },
    {
      "name": "stock-technical-scan",
      "description": "Calculate technical trend, entry zone, stop reference, and invalidation triggers from supplied levels.",
      "status": "implemented",
      "legacy_functions": [
        "stock_technical_scan"
      ],
      "payload_schema": {
        "type": "object",
        "required": [
          "price",
          "ma20"
        ],
        "properties": {
          "price": {
            "type": "number"
          },
          "ma20": {
            "type": "number"
          },
          "ma60": {
            "type": "number"
          },
          "support": {
            "type": "number"
          },
          "resistance": {
            "type": "number"
          },
          "rsi": {
            "type": "number"
          }
        }
      },
      "result_schema": {
        "$ref": "#/$defs/trade_plan_result"
      },
      "upstream_dependencies": [
        "explicit candidates",
        "explicit themes",
        "explicit technical levels",
        "latest prewarm market gate when used"
      ],
      "freshness_policy": "Plan freshness is inherited from supplied market gate, candidates, themes, and technical levels.",
      "error_behavior": [
        "candidates_missing",
        "themes_missing",
        "technical_inputs_missing",
        "market_filter_missing"
      ],
      "example": {
        "price": 10,
        "ma20": 9,
        "ma60": 8,
        "support": 8.5,
        "resistance": 12
      }
    },
    {
      "name": "strategy-advisor",
