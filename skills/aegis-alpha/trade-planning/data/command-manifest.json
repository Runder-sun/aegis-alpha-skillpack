    {
      "name": "trading-strategy-v2",
      "description": "Return the full investment plan under a versioned strategy schema.",
      "status": "implemented",
      "legacy_functions": [
        "trading_strategy_v2"
      ],
      "payload_schema": {
        "$ref": "#/$defs/trade_plan_payload"
      },
