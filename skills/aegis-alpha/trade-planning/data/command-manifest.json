{
  "package": "trade-planning",
  "description": "Trade setup planning and strategy generation.",
  "commands": [
    {
      "name": "full-investment-plan",
      "description": "Compose short-term setup, themes, targets, strategy, and technical references into a paper-only plan.",
      "status": "implemented",
      "legacy_functions": [
        "full_investment_plan"
      ],
      "payload_schema": {
        "$ref": "#/$defs/trade_plan_payload"
      },
      "result_schema": {
        "$ref": "#/$defs/trade_plan_result"
      },
      "upstream_dependencies": [
        "explicit candidates",
        "explicit themes",
        "explicit technical levels",
        "latest prewarm market gate when used"
      ],
      "freshness_policy": "Plan freshness is inherited from supplied market gate, candidates, themes, and technical levels.",
      "error_behavior": [
        "candidates_missing",
        "themes_missing",
        "technical_inputs_missing",
        "market_filter_missing"
      ],
      "example": {
        "themesurfer_status": "FULL",
        "risk_level": "green",
        "candidates": [
          {
            "name": "示例公司"
          }
        ],
        "technical": {
          "price": 10,
          "ma20": 9
        }
      }
    },
    {
      "name": "short-term-analysis",
      "description": "Score short-term candidates under market filter and risk caps.",
      "status": "implemented",
      "legacy_functions": [
        "short_term_analysis"
      ],
      "payload_schema": {
        "$ref": "#/$defs/trade_plan_payload"
      },
      "result_schema": {
